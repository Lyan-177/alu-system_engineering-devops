#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin

sudo apt-get update -y
sudo apt-get install haproxy -y

sudo tee /etc/haproxy/haproxy.cfg > /dev/null << 'CONF'
global
log /dev/log local0
log /dev/log local1 notice
chroot /var/lib/haproxy
stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
stats timeout 30s
user haproxy
group haproxy
daemon

defaults
log global
mode http
option httplog
option dontlognull
timeout connect 5000
timeout client 50000
timeout server 50000

frontend http_front
bind *:80
default_backend http_back

backend http_back
balance roundrobin
server 7332-web-01 35.176.14.134:80 check
server 7332-web-02 35.178.184.61:80 check
CONF

echo "ENABLED=1" | sudo tee /etc/default/haproxy > /dev/null
sudo service haproxy restart
